# AI service that writes the answers. Set ONE of these keys.
# Leave both empty to run in demo mode (copies the best-matching text, no AI).

# Abacus.AI RouteLLM key (used if set)
ABACUS_API_KEY=
# Model name on Abacus; "route-llm" lets Abacus pick the best model per question
ABACUS_MODEL=route-llm

# Anthropic (Claude) API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Password for uploading new versions of the resume / Q&A at /admin
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional. Websites allowed to use the bot, comma separated. If empty, the bot
# locks itself to the first website that uses the chat (see the admin page).
ALLOWED_ORIGINS=

# Optional. The person's name. If empty, it's read from the top of the resume.
OWNER_NAME=

# Optional widget settings (the <script> tag on the site needs no attributes)
# WIDGET_SUBTITLE=AI assistant · Answers from Jane's resume
# WIDGET_GREETING=Hi! Ask me anything about Jane's experience.
# WIDGET_SUGGESTIONS=What's her tech stack?|Is she open to new roles?|How can I contact her?
# WIDGET_COLOR=#4f46e5
# WIDGET_COLOR2=#7c3aed
# WIDGET_AVATAR=https://example.com/photo.jpg

PORT=3000
