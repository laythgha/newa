# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Password for uploading new versions of the resume / Q&A at /admin
ADMIN_TOKEN=change-me-to-a-long-random-string

# Websites allowed to use the bot, comma separated (your site's address).
# Leave empty while testing locally to allow any site.
ALLOWED_ORIGINS=https://www.example.com,https://example.com

# Name shown to the model so it can speak about the person correctly
OWNER_NAME=Jane Doe

PORT=3000
